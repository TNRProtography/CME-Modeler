    "test:sky": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-sky.mjs",
    "test:arrival-ensemble": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-arrival-ensemble.mjs",
